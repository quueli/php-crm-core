{
    "name": "quueli/php-crm-core",
    "description": "Catalog domain model and query layer of a Symfony/Doctrine CRM",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "doctrine/orm": "^2.17",
        "doctrine/doctrine-bundle": "^2.11",
        "symfony/framework-bundle": "^6.4",
        "symfony/validator": "^6.4"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    }
}
